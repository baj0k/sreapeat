<Window x:Class="Sreapeat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sreapeat"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F1EFE7">
    <Window.Resources>
        <Style x:Key="IconControlBaseStyle" TargetType="{x:Type Control}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconControlBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3DED0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D3CCBC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconToggleStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource IconControlBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E3DED0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#DAD2BE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#D3CCBC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CFC9BA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFAF5" />
        </Style>

        <Style x:Key="ShortcutCaptureTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="BorderBrush" Value="#CFC9BA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FBFAF5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Cursor" Value="IBeam" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#8A7C5F" />
                    <Setter Property="Background" Value="#FFFDF7" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Bottom"
              Margin="0,2,0,0"
              Background="#F6F4ED">
            <Border BorderBrush="#D8D3C6"
                    BorderThickness="0,1,0,0"
                    Padding="8,1">
                <DockPanel>
                    <TextBlock x:Name="StatusTextBlock"
                               DockPanel.Dock="Left"
                               FontSize="10"
                               Text="Ready..." />
                    <TextBlock x:Name="EventCountTextBlock"
                               DockPanel.Dock="Right"
                               FontSize="10"
                               Foreground="#6B6559"
                               Text="0 events" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Margin="8,0,8,0"
              VerticalAlignment="Center"
              ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SettingsPaneColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,10,0">
                        <ToggleButton x:Name="RecordToggleButton"
                                      Margin="0"
                                      Style="{StaticResource IconToggleStyle}"
                                      Checked="RecordToggleButton_OnChecked"
                                      Unchecked="RecordToggleButton_OnUnchecked"
                                      ToolTip="Start or stop recording">
                            <Grid Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="RecordIcon"
                                         Width="18"
                                         Height="18"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="#F25050"
                                         Stroke="#B53C3C"
                                         StrokeThickness="1.2" />
                                <Rectangle x:Name="RecordStopIcon"
                                           Width="13"
                                           Height="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="#B94242"
                                           Visibility="Collapsed" />
                            </Grid>
                        </ToggleButton>

                        <TextBlock x:Name="RecordShortcutTextBlock"
                                   Width="48"
                                   Margin="0,1,0,0"
                                   FontSize="8"
                                   Foreground="#6B6559"
                                   TextAlignment="Center"
                                   Text="F5" />
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <Button x:Name="PlayButton"
                                Margin="0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="PlayButton_OnClick"
                                ToolTip="Play or stop the current macro">
                            <Grid Width="24"
                                  Height="24"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Polygon x:Name="PlayIcon"
                                         Points="4,2 20,12 4,22"
                                         Fill="#91C433"
                                         Stroke="#6A8D23"
                                         StrokeThickness="1.2" />
                                <Rectangle x:Name="StopIcon"
                                           Width="13"
                                           Height="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RadiusX="1"
                                           RadiusY="1"
                                           Fill="#B94242"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <TextBlock x:Name="PlayShortcutTextBlock"
                                   Width="48"
                                   Margin="0,1,0,0"
                                   FontSize="8"
                                   Foreground="#6B6559"
                                   TextAlignment="Center"
                                   Text="F6" />
                    </StackPanel>

                    <ToggleButton x:Name="LoopToggleButton"
                                  Margin="0,0,0,10"
                                  Style="{StaticResource IconToggleStyle}"
                                  Checked="LoopToggleButton_OnChanged"
                                  Unchecked="LoopToggleButton_OnChanged"
                                  ToolTip="Loop playback until stopped">
                        <Grid Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path Stroke="#4D5A64"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M4,8 C4,5 7,3.5 10,3.5 H16" />
                            <Path Stroke="#4D5A64"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M20,16 C20,19 17,20.5 14,20.5 H8" />
                            <Path Stroke="#4D5A64"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M13,1.5 L16,3.5 L13,5.5" />
                            <Path Stroke="#4D5A64"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M11,18.5 L8,20.5 L11,22.5" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>

                <Grid Grid.Column="2"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="#484236"
                               Text="Repeat" />
                    <TextBox x:Name="RepeatCountTextBox"
                             Grid.Column="2"
                             Style="{StaticResource CompactTextBoxStyle}"
                             Text="1" />

                    <TextBlock Grid.Row="2"
                               VerticalAlignment="Center"
                               Foreground="#484236"
                               Text="Speed x" />
                    <TextBox x:Name="SpeedTextBox"
                             Grid.Row="2"
                             Grid.Column="2"
                             Style="{StaticResource CompactTextBoxStyle}"
                             Text="1.00" />
                </Grid>

                <Button x:Name="SettingsButton"
                        Grid.Column="4"
                        Width="26"
                        Height="26"
                        Margin="0,0,0,10"
                        Style="{StaticResource IconButtonStyle}"
                        Click="SettingsButton_OnClick"
                        ToolTip="Settings">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#5C564A"
                               Text="&#xE713;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <Border x:Name="SettingsPane"
                    Grid.Column="1"
                    Visibility="Collapsed"
                    Width="0"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="#F7F3E8"
                    BorderBrush="#D8D3C6"
                    BorderThickness="1,0,0,0"
                    Padding="12,0,8,0"
                    ClipToBounds="True">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 Fill="#F25050"
                                 Stroke="#B53C3C"
                                 StrokeThickness="1" />

                        <TextBox x:Name="RecordHotkeyTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ShortcutCaptureTextBoxStyle}"
                                 GotKeyboardFocus="ShortcutTextBox_OnGotKeyboardFocus"
                                 PreviewKeyDown="RecordHotkeyTextBox_OnPreviewKeyDown"
                                 PreviewMouseLeftButtonDown="ShortcutTextBox_OnPreviewMouseLeftButtonDown"
                                 ToolTip="Click here and press the record shortcut" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Polygon Width="11"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Points="1,0 11,6 1,12"
                                 Fill="#91C433"
                                 Stroke="#6A8D23"
                                 StrokeThickness="1" />

                        <TextBox x:Name="PlayHotkeyTextBox"
                                 Grid.Column="2"
                                 Style="{StaticResource ShortcutCaptureTextBoxStyle}"
                                 GotKeyboardFocus="ShortcutTextBox_OnGotKeyboardFocus"
                                 PreviewKeyDown="PlayHotkeyTextBox_OnPreviewKeyDown"
                                 PreviewMouseLeftButtonDown="ShortcutTextBox_OnPreviewMouseLeftButtonDown"
                                 ToolTip="Click here and press the play shortcut" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="RecordKeyboardCheckBox"
                                      FontSize="10"
                                      Foreground="#4D473B"
                                      Content="Keyboard"
                                      ToolTip="Toggle keyboard recording" />
                            <CheckBox x:Name="StraightPathsCheckBox"
                                      Margin="0,3,0,0"
                                      FontSize="10"
                                      Foreground="#4D473B"
                                      Content="Straight"
                                      ToolTip="Use straight mouse paths during playback" />
                        </StackPanel>

                        <Button x:Name="ImportButton"
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                Style="{StaticResource IconButtonStyle}"
                                Click="ImportButton_OnClick"
                                ToolTip="Import a recorded macro">
                            <Grid Width="14"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M2,11.5 H12" />
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M7,11.5 V4" />
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M4.5,6.5 L7,4 L9.5,6.5" />
                            </Grid>
                        </Button>

                        <Button x:Name="ExportButton"
                                Grid.Column="3"
                                Width="24"
                                Height="24"
                                Style="{StaticResource IconButtonStyle}"
                                Click="ExportButton_OnClick"
                                ToolTip="Export the current macro">
                            <Grid Width="14"
                                  Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M2,11.5 H12" />
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M7,1.5 V9" />
                                <Path Stroke="#5B5549"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M4.5,6.5 L7,9 L9.5,6.5" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
