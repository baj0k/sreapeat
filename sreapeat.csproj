<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sreapeat</RootNamespace>
    <AssemblyName>sreapeat</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>baj0k</Authors>
    <Company>baj0k</Company>
    <Product>sreapeat</Product>
    <Description>Compact Windows mouse and keyboard macro recorder and repeater.</Description>
    <RepositoryUrl>https://github.com/baj0k/sreapeat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/baj0k/sreapeat</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (c) baj0k</Copyright>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sreapeat.Tests" />
  </ItemGroup>

  <Target Name="RequireReleaseConfiguration"
          BeforeTargets="Build"
          Condition="'$(Configuration)' != 'Release' and '$(DesignTimeBuild)' != 'true'">
    <Error Text="Build this project with -c Release. Debug outputs are intentionally disabled to keep bin clean." />
  </Target>
</Project>
